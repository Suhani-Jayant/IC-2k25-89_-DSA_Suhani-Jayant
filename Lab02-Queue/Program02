#include <iostream>
using namespace std;

int queueArr[5];
int front = -1, rear = -1;

void enqueue(int value)
{
    if(rear == 4)
    {
        cout << "Queue Overflow" << endl;
    }
    else
    {
        if(front == -1)
        {
            front = 0;
        }

        rear++;
        queueArr[rear] = value;
    }
}

void dequeue()
{
    if(front == -1 || front > rear)
    {
        cout << "Queue Underflow" << endl;
    }
    else
    {
        cout << "Deleted Element: " << queueArr[front] << endl;
        front++;
    }
}

int main()
{
    enqueue(10);
    enqueue(20);
    enqueue(30);

    dequeue();
    dequeue();

    return 0;
}
