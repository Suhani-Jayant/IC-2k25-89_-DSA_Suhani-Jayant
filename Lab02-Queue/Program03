#include <iostream>
using namespace std;

int queueArr[5];
int front = -1, rear = -1;

void enqueue(int value)
{
    if((rear + 1) % 5 == front)
    {
        cout << "Queue Overflow" << endl;
    }
    else
    {
        if(front == -1)
        {
            front = rear = 0;
        }
        else
        {
            rear = (rear + 1) % 5;
        }

        queueArr[rear] = value;

        cout << value << " inserted" << endl;
    }
}

int main()
{
    enqueue(10);
    enqueue(20);
    enqueue(30);
    enqueue(40);

    return 0;
}
