#include <iostream>
using namespace std;

int main()
{
    int arr[5] = {10, 20, 30, 40, 50};
    int search, found = 0;

    cout << "Enter element to search: ";
    cin >> search;

    for(int i = 0; i < 5; i++)
    {
        if(arr[i] == search)
        {
            cout << "Element found at position: " << i + 1;
            found = 1;
            break;
        }
    }

    if(found == 0)
    {
        cout << "Element not found";
    }

    return 0;
}
