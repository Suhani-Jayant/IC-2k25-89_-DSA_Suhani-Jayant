#include <iostream>
using namespace std;

struct Node
{
    int data;
    Node* next;
};

int main()
{
    Node* first = new Node{10, NULL};
    first->next = new Node{20, NULL};

    Node* newNode = new Node{30, NULL};

    Node* temp = first;

    while(temp->next != NULL)
    {
        temp = temp->next;
    }

    temp->next = newNode;

    temp = first;

    cout << "Linked List: ";

    while(temp != NULL)
    {
        cout << temp->data << " ";
        temp = temp->next;
    }

    return 0;
}
