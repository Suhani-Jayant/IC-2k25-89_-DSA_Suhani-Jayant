#include <iostream>
using namespace std;

int main()
{
    int arr[5] = {50, 20, 40, 10, 30};
    int temp, minIndex;

    for(int i = 0; i < 4; i++)
    {
        minIndex = i;

        for(int j = i + 1; j < 5; j++)
        {
            if(arr[j] < arr[minIndex])
            {
                minIndex = j;
            }
        }

        temp = arr[i];
        arr[i] = arr[minIndex];
        arr[minIndex] = temp;
    }

    cout << "Sorted Array: ";

    for(int i = 0; i < 5; i++)
    {
        cout << arr[i] << " ";
    }

    return 0;
}
