#include <iostream>
using namespace std;

int stackArr[5];
int top = -1;

void push(int value)
{
    if(top == 4)
    {
        cout << "Stack Overflow";
    }
    else
    {
        top++;
        stackArr[top] = value;
        cout << value << " pushed into stack" << endl;
    }
}

int main()
{
    push(10);
    push(20);
    push(30);

    return 0;
}
