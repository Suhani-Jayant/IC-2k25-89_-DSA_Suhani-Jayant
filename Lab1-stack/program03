#include <iostream>
using namespace std;

int stackArr[5];
int top = -1;

void push(int value)
{
    top++;
    stackArr[top] = value;
}

void pop()
{
    if(top == -1)
    {
        cout << "Stack Underflow" << endl;
    }
    else
    {
        cout << "Deleted element: " << stackArr[top] << endl;
        top--;
    }
}

int main()
{
    push(10);
    push(20);
    push(30);

    pop();
    pop();

    return 0;
}
